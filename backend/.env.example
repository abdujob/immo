# === CONFIGURATION SERVEUR (BACKEND) ===
# Ce fichier est un modèle. Copiez-le vers '.env' et remplissez les valeurs.

# URL de la base de données (ex: PostgreSQL sur Neon.tech ou SQLite local)
# SQLite local: "file:./dev.db"
# PostgreSQL: "postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="votre_url_de_base_de_donnees_ici"

# Secret JWT - utiliser une chaîne longue, unique et aléatoire
JWT_SECRET="votre_secret_jwt_super_long_et_aleatoire_ici"

# Port d'écoute du serveur (par défaut 4000)
PORT=4000

# URL du Frontend (pour CORS et liens d'emails)
# Local: http://localhost:3000
# Production: https://votre-site.vercel.app
FRONTEND_URL="http://localhost:3000"

# Environnement (development, production)
NODE_ENV="development"

# === CONFIGURATION SMTP (ENVOI D'EMAILS) ===
SMTP_HOST="smtp.exemple.com"
SMTP_PORT=587
SMTP_USER="votre-email@exemple.com"
SMTP_PASS="votre-mot-de-passe-ou-cle-api"
SMTP_SECURE="false"
EMAIL_FROM="Immo - Plateforme Immobilière <votre-email@exemple.com>"
