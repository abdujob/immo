# Base de données PostgreSQL (obtenu depuis Neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret JWT - choisir une valeur longue et aléatoire
JWT_SECRET="votre_secret_jwt_super_long_et_aleatoire_ici"

# URL du frontend (à remplir après déploiement Vercel)
FRONTEND_URL="https://votre-site.vercel.app"

# Environnement
NODE_ENV="production"
