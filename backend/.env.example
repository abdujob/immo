# Base de données PostgreSQL (obtenu depuis Neon.tech)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Secret JWT - choisir une valeur longue et aléatoire
JWT_SECRET="votre_secret_jwt_super_long_et_aleatoire_ici"

# URL du frontend (à remplir après déploiement Vercel)
FRONTEND_URL="https://immo-six-iota.vercel.app"

# Port (optionnel, par défaut 4000)
PORT="4000"

# Environnement
NODE_ENV="production"

# Configuration SMTP (pour l'envoi d'emails)
# Laissez vide pour afficher les liens dans la console du backend en développement
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
